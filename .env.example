# Salin file ini menjadi .env.local lalu isi dengan data PostgreSQL kamu.
# Password dengan karakter khusus harus di-encode (misalnya @ menjadi %40).
DATABASE_URL=postgresql://postgres:PASSWORD_KAMU@localhost:5432/platform_kursus

# Rahasia untuk menandatangani sesi login JWT (dipakai di Tahap 3). Isi minimal 32 karakter acak.
SESSION_SECRET=ganti-dengan-teks-acak-minimal-32-karakter-rahasia